{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "nextjs", "jsx-a11y"],
  "ignorePatterns": [".next/**", "node_modules/**", "coverage/**", "next-env.d.ts"],
  "overrides": [
    {
      "files": ["src/app/**/opengraph-image.tsx"],
      "rules": {
        "nextjs/no-img-element": "off"
      }
    },
    {
      "files": ["src/components/session/recording-player.tsx"],
      "rules": {
        "jsx-a11y/media-has-caption": "off"
      }
    }
  ]
}
