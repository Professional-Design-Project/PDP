# Local configuration is loaded from backend/.env. Never commit real credentials.
VOICEBOT_GOOGLE_API_KEY=
# Select realtime or cascaded. Realtime currently supports Gemini.
VOICEBOT_VOICE_ARCHITECTURE=realtime
VOICEBOT_REALTIME_PROVIDER=gemini
# Cascaded pipeline: ElevenLabs streaming STT -> OpenRouter LLM -> ElevenLabs TTS.
VOICEBOT_STT_PROVIDER=elevenlabs
VOICEBOT_LLM_PROVIDER=openrouter
VOICEBOT_TTS_PROVIDER=elevenlabs
VOICEBOT_ELEVENLABS_API_KEY=
VOICEBOT_ELEVENLABS_VOICE_ID=
VOICEBOT_ELEVENLABS_STT_MODEL=scribe_v2_realtime
VOICEBOT_ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
VOICEBOT_OPENROUTER_VOICE_MODEL=openai/gpt-4.1-mini
VOICEBOT_GEMINI_MODEL=gemini-3.8-live
VOICEBOT_GEMINI_VOICE=Charon
# Feedback is independent of the voice engine: gemini or openrouter.
VOICEBOT_FEEDBACK_PROVIDER=gemini
VOICEBOT_FEEDBACK_MODEL=gemini-3.5-flash
VOICEBOT_OPENROUTER_API_KEY=
VOICEBOT_OPENROUTER_FEEDBACK_MODEL=openai/gpt-4.1-mini
VOICEBOT_DATABASE_PATH=data/voicebot.sqlite3
# Leave both empty to run without sign-in on the local SQLite file above.
# Project URL, for example https://abcdefghijklmnop.supabase.co
VOICEBOT_SUPABASE_URL=
# Session pooler connection string from Connect > Session pooler
VOICEBOT_DATABASE_URL=
# Secret key (sb_secret_...) from Settings > API Keys, used to delete accounts and expired recordings
VOICEBOT_SUPABASE_SECRET_KEY=
# Saved conversation recordings are removed after this many days
VOICEBOT_RECORDING_RETENTION_DAYS=30
VOICEBOT_CORS_ORIGINS=["http://localhost:3000"]
# Use [] on localhost; configure STUN/TURN on both peers for remote connections.
VOICEBOT_ICE_SERVERS=[]
VOICEBOT_MAX_SESSIONS=8
VOICEBOT_PENDING_TIMEOUT_SECONDS=120
VOICEBOT_CONNECT_TIMEOUT_SECONDS=30
VOICEBOT_SESSION_TIMEOUT_SECONDS=900
VOICEBOT_CLEANUP_TIMEOUT_SECONDS=10
VOICEBOT_SESSION_TOKEN_TTL_SECONDS=86400
