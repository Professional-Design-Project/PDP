# Local configuration is loaded from backend/.env. Never commit real credentials.
VOICEBOT_GOOGLE_API_KEY=
VOICEBOT_GEMINI_MODEL=gemini-3.8-live
VOICEBOT_GEMINI_VOICE=Charon
VOICEBOT_FEEDBACK_MODEL=gemini-3.5-flash
VOICEBOT_DATABASE_PATH=data/voicebot.sqlite3
# Leave both empty to run without sign-in on the local SQLite file above.
# Project URL, for example https://abcdefghijklmnop.supabase.co
VOICEBOT_SUPABASE_URL=
# Session pooler connection string from Connect > Session pooler
VOICEBOT_DATABASE_URL=
# Secret key (sb_secret_...) from Settings > API Keys, used only to delete accounts
VOICEBOT_SUPABASE_SECRET_KEY=
VOICEBOT_CORS_ORIGINS=["http://localhost:3000"]
# Use [] on localhost; configure STUN/TURN on both peers for remote connections.
VOICEBOT_ICE_SERVERS=[]
VOICEBOT_MAX_SESSIONS=8
VOICEBOT_PENDING_TIMEOUT_SECONDS=120
VOICEBOT_CONNECT_TIMEOUT_SECONDS=30
VOICEBOT_SESSION_TIMEOUT_SECONDS=900
VOICEBOT_CLEANUP_TIMEOUT_SECONDS=10
VOICEBOT_SESSION_TOKEN_TTL_SECONDS=86400
